<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Workshop reminders: local notifications 10 minutes before registration opens and closes -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On time rather than up to several minutes late in Doze; granted by default before Android 14.
         An app-op permission any app may request; lint wrongly treats it as system-only -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedRationalAndroid"
        android:usesCleartextTraffic="true"> <!-- Required to talk to local http:// without HTTPS in dev -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MedRationalAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.reminders.WorkshopReminderReceiver"
            android:exported="false" />
    </application>

</manifest>