<?xml version="1.0" encoding="utf-8"?>
<!-- Push notifications. The backend sends these keys (title_loc_key/body_loc_key) and their
     arguments, and Android shows them in the app's language. Workshop pushes get the project title
     as %1$s. The names must match WorkshopNotificationServiceImpl.pushLocalizationKey and
     NewFilesNotificationServiceImpl in the backend. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources" tools:locale="fr">
    <string name="push_created_fcfs_title">Nouveau projet : %1$s</string>
    <string name="push_created_fcfs_body">« %1$s » arrive bientôt. Consultez les dates d’inscription dans l’app.</string>
    <string name="push_created_motivation_title">Nouveau projet : %1$s</string>
    <string name="push_created_motivation_body">Les candidatures pour « %1$s » ouvrent bientôt. Consultez les dates et préparez votre lettre de motivation.</string>
    <string name="push_opening_soon_fcfs_title">Ouverture dans 10 min (premier arrivé, premier servi) : %1$s</string>
    <string name="push_opening_soon_fcfs_body">Places limitées ! Les inscriptions pour « %1$s » ouvrent dans 10 minutes.</string>
    <string name="push_opening_soon_motivation_title">Candidatures ouvertes dans 10 min : %1$s</string>
    <string name="push_opening_soon_motivation_body">Les candidatures pour « %1$s » ouvrent dans 10 minutes. Préparez votre dossier.</string>
    <string name="push_opened_fcfs_title">Places disponibles : %1$s</string>
    <string name="push_opened_fcfs_body">Les inscriptions (premier arrivé, premier servi) sont ouvertes pour « %1$s » ! Réservez votre place.</string>
    <string name="push_opened_motivation_title">Candidatures ouvertes : %1$s</string>
    <string name="push_opened_motivation_body">Les candidatures pour « %1$s » sont ouvertes. Envoyez votre lettre de motivation avant la date limite.</string>
    <string name="push_closing_soon_fcfs_title">Fermeture des inscriptions dans 10 min : %1$s</string>
    <string name="push_closing_soon_fcfs_body">Les inscriptions pour « %1$s » ferment dans 10 minutes.</string>
    <string name="push_closing_soon_motivation_title">Plus que 10 minutes : %1$s</string>
    <string name="push_closing_soon_motivation_body">La date limite de candidature pour « %1$s » est dans 10 minutes. Envoyez votre lettre de motivation maintenant.</string>
    <string name="push_closed_fcfs_title">Inscriptions closes : %1$s</string>
    <string name="push_closed_fcfs_body">Les inscriptions pour « %1$s » sont terminées.</string>
    <string name="push_closed_motivation_title">Candidatures closes : %1$s</string>
    <string name="push_closed_motivation_body">La période de candidature pour « %1$s » est terminée. Les dossiers sont en cours d’examen.</string>

    <!-- New study files, grouped by NewFilesNotificationServiceImpl in the backend. push_new_file
         gets the file name and its reasoning, the others the count (always 2 or more) and the reasoning -->
    <string name="push_new_file_title">Nouveau fichier : %1$s</string>
    <string name="push_new_file_body">Dans %2$s</string>
    <string name="push_new_files_reasoning_title">%1$s nouveaux fichiers dans %2$s</string>
    <string name="push_new_files_reasoning_body">Ouvrez l’app pour voir les nouveautés.</string>
    <string name="push_new_files_title">%1$s nouveaux fichiers</string>
    <string name="push_new_files_body">Ouvrez l’app pour voir les nouveautés.</string>
</resources>
