<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight so system dialogs and the window follow the phone's dark mode; Compose draws the rest -->
    <style name="Theme.Swisra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/swisra_background</item>
    </style>

    <!-- Shown while the app starts; MainActivity switches to Theme.Swisra with installSplashScreen() -->
    <style name="Theme.Swisra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/swisra_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Swisra</item>
    </style>
</resources>
