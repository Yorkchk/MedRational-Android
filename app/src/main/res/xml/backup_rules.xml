<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower; see data_extraction_rules.xml for Android 12+.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The session is encrypted with an Android Keystore key, which is never backed up:
         restored without it, the file can't be read. Users sign in again instead -->
    <exclude domain="sharedpref" path="medrational_secure_prefs.xml" />
</full-backup-content>
