<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and higher.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The session is encrypted with an Android Keystore key, which never leaves the device:
         restored without it, the file can't be read. Users sign in again instead -->
    <cloud-backup>
        <exclude domain="sharedpref" path="medrational_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="medrational_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
